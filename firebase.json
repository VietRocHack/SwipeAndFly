{
  "hosting": {
    "target": "swipeandfly",
    "public": "frontend/dist",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "swipeandfly-server",
          "region": "us-central1"
        }
      },
      {
        "source": "/video_analysis/**",
        "run": {
          "serviceId": "swipeandfly-server",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
